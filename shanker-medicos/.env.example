# ---------------------------------------------------------------------------
# SHANKER MEDICOS environment. Copy to .env.local for development.
# Never commit real values. Only NEXT_PUBLIC_* values reach the browser.
# ---------------------------------------------------------------------------

# Public URL of the site (used for canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.example.com

# --- Production: Supabase (leave empty to run in development mode) --------
# Project Settings -> API. The anon key is public by design; Row Level
# Security in supabase/migrations decides what it can do.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# No service-role key is needed by the app. Do not add one here.

# --- Development mode only (no Supabase) -----------------------------------
# One admin account stored in env, session in a signed cookie.
ADMIN_DEV_EMAIL=
ADMIN_DEV_PASSWORD=
# 32+ random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=

# --- Optional ---------------------------------------------------------------
# Google Search Console HTML-tag verification token (content="..." value only).
GOOGLE_SITE_VERIFICATION=

# --- Marketing (optional; nothing loads until the visitor accepts cookies) ---
# Google Tag Manager container (GTM-XXXXXXX), GA4 measurement ID (G-XXXXXXXXXX),
# Meta Pixel ID (digits). Use GTM *or* GA4 directly, not both for the same property.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Automation (optional) ----------------------------------------------------
# Every Shanker Club sign-up is POSTed here as JSON (n8n, Zapier, Make, a CRM).
# Must be https. The body is signed: header X-Shanker-Signature: sha256=<HMAC>.
AUTOMATION_WEBHOOK_URL=
AUTOMATION_WEBHOOK_SECRET=
