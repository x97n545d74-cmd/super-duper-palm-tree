# Claude API key from console.anthropic.com (keep it secret, never commit it)
ANTHROPIC_API_KEY=
# A PIN the shop types once on each device, so strangers cannot use your key
APP_PIN=
# Optional
PORT=8080
# Cheap model reads first; the backup is used only when a paper's totals do not add up
LEDGER_MODEL=claude-haiku-5-5
LEDGER_BACKUP_MODEL=claude-opus-5-5
LEDGER_EFFORT=medium
